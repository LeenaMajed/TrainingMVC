@{
}
@model Customer



    
        
            <h3 class="mb-0">Customer Details</h3>
       <br />
       <br />
       

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Customer ID
                </div>

                <div class="col-md-9">
                    @Model.CustomerID
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Customer Name
                </div>

                <div class="col-md-9">
                    @Model.CustomerName
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Mobile
                </div>

                <div class="col-md-9">
					@Model.MobileNo
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-3 fw-bold">
                    Email
                </div>

                <div class="col">
                    @Model.Email
                </div>
            </div>

            <div class="row ">
                <div class="col-md-3 fw-bold">
                    City
                </div>

                <div class="col-md-9">
                    @Model.City
                </div>
            </div>


       
            <br />
            <a asp-action="Index"
                   class="btn btn-primary">

                Back

            </a>

      



