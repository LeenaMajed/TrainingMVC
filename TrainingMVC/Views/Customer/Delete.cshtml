@model TrainingMVC.Models.Customer

<h2>Delete Customer</h2>

<h4>Are you sure you want to delete this customer?</h4>

<hr />

<p><strong>ID:</strong> @Model.CustomerID</p>
<p><strong>Name:</strong> @Model.CustomerName</p>
<p><strong>Email:</strong> @Model.Email</p>
<p><strong>Mobile No:</strong> @Model.MobileNo</p>
<p><strong>City:</strong> @Model.City</p>

<form method="post" action="/Customer/DeleteConfirmed">

    <input type="hidden"
           name="id"
           value="@Model.CustomerID" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-controller="Customer"
           asp-action="Index"
           class="btn btn-secondary">
        Cancel
    </a>

</form>