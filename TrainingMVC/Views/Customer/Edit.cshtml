@model TrainingMVC.Models.Customer

<h2>Edit Customer</h2>

<form method="post" asp-controller="Customer" asp-action="Edit">

    <input type="hidden" name="CustomerID" value="@Model.CustomerID" />

    <div class="form-group">
        <label>Customer Name</label>
        <input type="text" name="CustomerName" value="@Model.CustomerName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Mobile No</label>
        <input type="text" name="MobileNo" value="@Model.MobileNo" class="form-control" />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input type="text" name="Email" value="@Model.Email" class="form-control" />
    </div>

    <div class="form-group">
        <label>City</label>
        <input type="text" name="City" value="@Model.City" class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Save</button>

</form>